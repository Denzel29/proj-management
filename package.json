{
  "name": "forge-pm",
  "version": "0.1.0",
  "private": true,
  "description": "Forge project management: tasks, sprints, milestones, pages. Node + Prisma + Postgres.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node server/test/run.js",
    "sandbox": "node server/test/sandbox.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "prisma": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
}
