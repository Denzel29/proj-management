# Production settings for the VPS. Copy to .env on the server and fill in. Never commit .env.
# Used by docker-compose.yml (database password) and passed into the app container.

APP_URL=https://msforge.denzelchiu.me

# Only this email can complete first-run setup (so a stranger cannot claim the admin account).
# Set it to your own address; it has no effect once the first admin exists.
SETUP_EMAIL=
MAX_UPLOAD_MB=25

# Database (a Postgres container started by docker-compose). Use a long random password,
# letters and numbers only, for example:  openssl rand -hex 24
POSTGRES_USER=forge
POSTGRES_DB=forge
POSTGRES_PASSWORD=CHANGE_ME

# Email through Google SMTP. SMTP_PASS must be a Google App Password (quote it if it has spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Gmail replaces the From address with the logged-in account UNLESS the address is a verified
# "Send mail as" alias on that account (Gmail > Settings > Accounts). Use such an alias here.
MAIL_FROM="Forge <your-address@gmail.com>"
