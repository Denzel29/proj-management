# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Public URL of the site (used in email links).
# Production: APP_URL=https://msforge.denzelchiu.me
APP_URL=http://localhost:3000

# Postgres connection string (Prisma format). If the password has special characters
# (@ : / ? #) URL-encode them, e.g. @ becomes %40.
DATABASE_URL="postgresql://forge:CHANGE_ME@localhost:5432/forge?schema=public"

# Where uploaded files are stored (outside the web root)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Email via Google SMTP (if SMTP_HOST is empty, email is skipped and in-app still works).
# SMTP_USER is your full Gmail/Workspace address. SMTP_PASS must be a Google
# "App password" (needs 2-Step Verification on), NOT your normal password.
# Port 465 + SMTP_SECURE=true, or port 587 + SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=


# Gmail rewrites the From address to the account you authenticate as.
MAIL_FROM="Forge <your-address@gmail.com>"
